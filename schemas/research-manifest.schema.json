{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapeshift-labs.github.io/evidence-kit/schemas/research-manifest.schema.json",
  "title": "Agent Evidence Research Fetch Manifest",
  "type": "object",
  "required": ["version", "topic", "generatedAt", "sources"],
  "properties": {
    "version": { "type": "integer" },
    "topic": { "type": "string" },
    "generatedAt": { "type": "string" },
    "configPath": { "type": "string" },
    "cacheRoot": { "type": "string" },
    "dataRoot": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "status"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "status": { "type": "string" },
          "url": { "type": "string" },
          "package": { "type": "string" },
          "ref": { "type": "string" },
          "commit": { "type": "string" },
          "bytes": { "type": "integer" },
          "sha256": { "type": "string" },
          "localPath": { "type": "string" },
          "error": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
