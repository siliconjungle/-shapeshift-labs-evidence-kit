{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapeshift-labs.github.io/evidence-kit/schemas/research-sources.schema.json",
  "title": "Agent Evidence Research Source Config",
  "type": "object",
  "required": ["version", "topic", "sources"],
  "properties": {
    "version": { "type": "integer" },
    "topic": { "type": "string" },
    "archetype": { "type": "string" },
    "generatedBy": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["git", "url", "npm", "file", "inline"] },
          "url": { "type": "string" },
          "package": { "type": "string" },
          "path": { "type": "string" },
          "text": { "type": "string" },
          "ref": { "type": "string" },
          "depth": { "type": "integer" },
          "fileName": { "type": "string" },
          "localName": { "type": "string" },
          "why": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
